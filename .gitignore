node_modules/
dist/
*.tsbuildinfo
.sem

# Environment
.env
.env.local

# .kennen.yaml is ignored to keep personal vault page IDs and tokens out of
# version control. Copy .kennen.example.yaml to .kennen.yaml locally and fill
# in your own pageId; the pre-commit guard rejects any staged .kennen.yaml.
.kennen.yaml
# .lore.yaml holds the same per-user vault values as .kennen.yaml; never commit it.
.lore.yaml

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# Per-developer Claude Code state. `kennen install` writes hooks under
# `~/.claude/projects/<encoded>/settings.json` (the per-user-per-project
# location), never into this repo. The committed `.claude/settings.json`
# carries only public plugin marketplaces and shared env; internal
# marketplaces, permissions, and telemetry labels belong in the gitignored
# `settings.local.json`.
.claude/settings.local.json
.claude/worktrees/
.claudio/

# Ad-hoc / empirical verification scripts — intentionally not part of the
# build or test surface. Use for one-off Notion API experiments.
scripts/

# Local eval run artifacts. Commit suite and memory fixtures, not generated
# run output.
evals/results/

# Downloaded public benchmark corpora are checksum-pinned but too large to
# commit. Keep the manifest and tiny fixtures in version control.
evals/skill-retrieval/corpora/
evals/skill-retrieval/manifests/

# Defensive: the autosave-learning dedup lock dir lives under
# `KENNEN_HOOK_STATE_DIR` (default: tmpdir). An interim version of the dedup
# code wrote into cwd; this guard keeps any future regression from
# leaking lock state into the repo.
autosave-learning-locks/

# Per-run state written by local review and PR automation tooling.
.please/state/
