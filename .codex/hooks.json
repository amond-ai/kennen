{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "KENNEN_AGENT_NAME=Codex kennen hooks wakeup",
            "statusMessage": "Loading Kennen context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "KENNEN_AGENT_NAME=Codex kennen hooks autosave",
            "timeout": 30,
            "statusMessage": "Saving Kennen context"
          }
        ]
      }
    ]
  }
}
